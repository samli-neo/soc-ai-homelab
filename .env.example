# Copy to .env and replace every value before running.
# Never commit real values.

WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me-long-random-value
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=change-me-long-random-value
WAZUH_API_PASS=change-me-long-random-value
WAZUH_SAML_EXCHANGE_KEY=change-me-long-random-value

SHUFFLE_OPENSEARCH_USERNAME=admin
SHUFFLE_OPENSEARCH_PASSWORD=change-me-long-random-value
SHUFFLE_DEFAULT_USERNAME=admin@example.local
SHUFFLE_DEFAULT_PASSWORD=change-me-long-random-value
SHUFFLE_DEFAULT_APIKEY=change-me-long-random-value

MISP_MYSQL_ROOT_PASSWORD=change-me-long-random-value
MISP_MYSQL_PASSWORD=change-me-long-random-value
MISP_ADMIN_PASSPHRASE=change-me-long-random-value

THEHIVE_PLAY_SECRET=change-me-long-random-value
THEHIVE_OAUTH_CLIENT_SECRET=change-me-long-random-value
CORTEX_OIDC_CLIENT_SECRET=change-me-long-random-value

# Deployment scripts read these locally; do not publish real values.
PROXMOX_HOST=192.0.2.10
PROXMOX_SSH_PASS=change-me
PFSENSE_WEB_PASS=change-me
